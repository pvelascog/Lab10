# Copiar a .env y completar. Nunca subir .env al repositorio.

# Base de datos (Docker Compose ya la define para los servicios api y trabajador)
DATABASE_URL=postgresql+asyncpg://validador:validador@localhost:5432/validador

# Firma de los tokens de sesión. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambiar-por-un-valor-aleatorio-largo

# Entorno: desarrollo | pruebas | produccion
ENTORNO=desarrollo
# true en producción (HTTPS): la cookie de sesión solo viaja cifrada
COOKIE_SEGURA=false

# Origen del frontend (CORS y cookies)
URL_FRONTEND=http://localhost:5173

# Clave de la API de Claude: necesaria desde la Fase 7 (benchmark y recomendaciones)
ANTHROPIC_API_KEY=
